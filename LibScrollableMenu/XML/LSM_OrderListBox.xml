<GuiXml>
    <!-- OrderListBox presentation adapted from LAM2_orderlistbox_widget.xml.
         Copyright (c) 2016 Ryan Lakanen (Seerah). See LICENSE-OrderListBox.txt. -->
    <Controls>
        <!-- OrderListBox presentation: selectable text, thin row highlight and a side button rail. -->
        <Label name="LSM_OrderListBox_Row" virtual="true" mouseEnabled="true" font="ZoFontWinH4" maxLineCount="1" wrapMode="ELLIPSIS" verticalAlignment="CENTER" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL">
            <OnInitialized>
                ZO_SelectableLabel_OnInitialized(self)
            </OnInitialized>
        </Label>

        <TopLevelControl name="LSM_OrderListBox_DragPreview" mouseEnabled="false" hidden="true" tier="HIGH">
            <Controls>
                <Label name="$(parent)Label" font="ZoFontGame" maxLineCount="1" wrapMode="ELLIPSIS" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED">
                    <AnchorFill/>
                </Label>
            </Controls>
        </TopLevelControl>

        <Control name="LSM_OrderListBox_Widget" virtual="true" hidden="true">
            <Controls>
                <Backdrop name="$(parent)Backdrop" inherits="ZO_DefaultBackdrop">
                    <AnchorFill/>
                </Backdrop>
                <Control name="$(parent)Filter" hidden="true">
                    <Dimensions y="37"/>
                    <Anchor point="TOPLEFT" offsetX="5" offsetY="4"/>
                    <Anchor point="TOPRIGHT" offsetX="-5" offsetY="4"/>
                    <Controls>
                        <Button name="$(parent)Reset" inherits="ZO_ButtonBehaviorClickSound">
                            <Dimensions x="32" y="32"/>
                            <Anchor point="TOPLEFT"/>
                            <Textures normal="EsoUI/Art/Help/help_tabIcon_feedback_up.dds" pressed="EsoUI/Art/Help/help_tabIcon_feedback_down.dds" mouseOver="EsoUI/Art/Help/help_tabIcon_feedback_over.dds"/>
                        </Button>
                        <Backdrop name="$(parent)Input" inherits="ZO_SingleLineEditBackdrop_Keyboard">
                            <Dimensions y="32"/>
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Reset" relativePoint="TOPRIGHT" offsetX="5"/>
                            <Anchor point="TOPRIGHT"/>
                            <Controls>
                                <EditBox name="$(parent)Edit" inherits="ZO_DefaultEditForBackdrop" defaultText="SI_SEARCH_FILTER_BY"/>
                            </Controls>
                        </Backdrop>
                    </Controls>
                </Control>
                <Control name="$(parent)List" inherits="ZO_ScrollList"/>
                <Label name="$(parent)Empty" font="ZoFontGame" text="SI_SORT_FILTER_LIST_NO_RESULTS" horizontalAlignment="CENTER">
                    <Anchor point="CENTER" relativeTo="$(parent)List" relativePoint="CENTER"/>
                </Label>
            </Controls>
        </Control>
    </Controls>
</GuiXml>
